// Langkah 4: Cara Penggunaan Query di Screen (Contoh: src/app/index.tsx)
// Di dalam halaman, Anda tinggal mengimpor query dan menjalankannya menggunakan useQuery.

// src/app/index.tsx
import { ScrollView, ActivityIndicator, Text } from "react-native";
import { SafeAreaProvider, SafeAreaView } from "react-native-safe-area-context";
import { useQuery } from "@apollo/client";
import { GET_LOCATIONS } from "../graphql/queries"; // Import query dari folder graphql

import FloatingButton from "@/components/FloatingButton";
import TaskGrid from "@/components/TaskGrid";
import TaskSection from "@/components/TaskSection";

export default function Index() {
  // Panggil useQuery di sini
  const { loading, error, data } = useQuery(GET_LOCATIONS);

  return (
    <SafeAreaProvider>
      <SafeAreaView style={{ flex: 1 }}>
        {loading ? (
          <ActivityIndicator size="large" style={{ flex: 1 }} />
        ) : error ? (
          <Text>Terjadi kesalahan: {error.message}</Text>
        ) : (
          <ScrollView>
            {/* Di sini Anda bisa mengirimkan data.locations ke komponen anak */}
            <TaskGrid locations={data?.locations} /> 
            <TaskSection />
          </ScrollView>
        )}
        <FloatingButton />
      </SafeAreaView>
    </SafeAreaProvider>
  );
}
