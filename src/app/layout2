// Langkah 3: Sesuaikan Penggunaan di src/app/_layout.tsx
// Dengan memisahkan client ke berkas global, kode di src/app/_layout.tsx
//  Anda menjadi sangat bersih dan rapi:

import { router, Stack } from "expo-router";
import { Button } from "react-native";
import { AuthProvider, useAuth } from "../../context/AuthContext";
import { useEffect } from "react";
import { ApolloProvider } from "@apollo/client";
import { client } from "../graphql/client"; // Import client global yang sudah dibuat

function RootLayoutNav() {
  const { authState, onLogout } = useAuth();

  useEffect(() => {
    if (authState?.authenticated === false) {
      router.replace("/SignIn");
    } else {
      router.replace("/");
    }
  }, [authState?.authenticated]);

  return (
    <Stack>
      {authState?.authenticated ? (
        <Stack.Screen
          options={{
            headerRight: () => <Button onPress={onLogout} title="Sign Out" />,
          }}
          name="index"
        />
      ) : (
        <Stack.Screen options={{ headerShown: false }} name="SignIn" />
      )}
    </Stack>
  );
}

export default function RootLayout() {
  return (
    <AuthProvider>
      {/* Bungkus seluruh aplikasi dengan ApolloProvider */}
      <ApolloProvider client={client}>
        <RootLayoutNav />
      </ApolloProvider>
    </AuthProvider>
  );
}
